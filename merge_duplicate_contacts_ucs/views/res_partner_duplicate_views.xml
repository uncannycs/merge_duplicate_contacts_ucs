<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_res_partner_duplicate_search" model="ir.ui.view">
        <field name="name">res.partner.duplicate.search</field>
        <field name="model">res.partner.duplicate</field>
        <field name="arch" type="xml">
            <search string="Search Duplicate Contacts">
                <field name="name" string="Name"/>
                <field name="email" string="Email"/>
                <separator/>
                <filter name="filter_by_name" string="Duplicates by Name" domain="[('duplicate_by', '=', 'name')]"/>
                <filter name="filter_by_email" string="Duplicates by Email" domain="[('duplicate_by', '=', 'email')]"/>
                <separator/>
                <filter name="filter_is_company" string="Companies" domain="[('is_company', '=', True)]"/>
                <filter name="filter_is_contact" string="Individuals" domain="[('is_company', '=', False)]"/>
                <group name="group_by">
                    <filter string="Reason" name="group_by_reason" context="{'group_by': 'duplicate_by'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_res_partner_duplicate_list" model="ir.ui.view">
        <field name="name">res.partner.duplicate.list</field>
        <field name="model">res.partner.duplicate</field>
        <field name="arch" type="xml">
            <list string="Duplicate Contacts" create="0" delete="0" edit="0">
                <field name="duplicate_by" string="Duplicate Reason"/>
                <field name="name" string="Name / Matched Names"/>
                <field name="email" string="Email / Matched Emails"/>
                <field name="type" string="Address Type"/>
                <field name="is_company" string="Is a Company"/>
                <field name="duplicate_count" string="Duplicate Count"/>
                <field name="duplicate_ids" string="Duplicate IDs"/>
                <button name="action_view_partners"
                        string="Details"
                        type="object"
                        icon="fa-search"
                        class="btn-sm btn-primary"/>
            </list>
        </field>
    </record>

    <record id="view_res_partner_duplicate_form" model="ir.ui.view">
        <field name="name">res.partner.duplicate.form</field>
        <field name="model">res.partner.duplicate</field>
        <field name="arch" type="xml">
            <form string="Duplicate Contact Info" create="0" delete="0" edit="0">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Contact Name(s)"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Contact Info">
                            <field name="duplicate_by" readonly="1"/>
                            <field name="email" readonly="1"/>
                            <field name="type" readonly="1"/>
                        </group>
                        <group string="Duplicate Info">
                            <field name="is_company" readonly="1"/>
                            <field name="duplicate_count" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Duplicate Partner IDs">
                            <field name="duplicate_ids" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_res_partner_duplicate" model="ir.actions.act_window">
        <field name="name">Duplicate Contacts</field>
        <field name="res_model">res.partner.duplicate</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_res_partner_duplicate_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No duplicate contacts found!
            </p>
            <p>
                Great news — your contact database has no duplicate entries based on
                matching name or email.
            </p>
        </field>
    </record>

    <record id="action_merge_duplicate_partners" model="ir.actions.server">
        <field name="name">Merge Duplicates</field>
        <field name="model_id" ref="merge_duplicate_contacts_ucs.model_res_partner_duplicate"/>
        <field name="binding_model_id" ref="merge_duplicate_contacts_ucs.model_res_partner_duplicate"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            action = records.action_merge_duplicates()
        </field>
    </record>

    <menuitem id="menu_res_partner_duplicate"
        name="Duplicate Contacts"
        action="action_res_partner_duplicate"
        parent="contacts.menu_contacts"
        sequence="3"/>

</odoo>
